{
  "targets": {
    "REMOTE_ALIAS": {
      "url_prefix": "sftp://REMOTE_USER@REMOTE_HOST"
    }
  },
  "commands": {
    "open": ["kioclient", "exec", "{url}", "{mime_type}"],
    "edit": ["kate"],
    "edit_wait": ["kate", "--block"],
    "diff": ["kompare", "-c"],
    "diff_wait": ["kompare", "-c"]
  }
}
