[Unit]
Description=Remote Open bridge
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/remote-open bridge --socket %t/remote-open.sock --config %h/.config/remote-open/config.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
